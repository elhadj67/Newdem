# --- Base de données (PostgreSQL + PostGIS) ---
DATABASE_URL="postgresql://newdem:newdem@localhost:5432/newdem?schema=public"

# --- Application ---
NODE_ENV="development"          # 'production' active la validation stricte des secrets
PORT=3000
APP_URL="https://api.newdem.sn"
JWT_SECRET="changez-moi"
# Origines autorisées (CORS), séparées par des virgules. Vide en prod = aucune.
CORS_ORIGINS="https://app.newdem.sn,https://admin.newdem.sn"

# --- Stockage des pièces KYC ---
# Dev : dossier local privé. Prod : basculer sur un bucket S3/GCS PRIVÉ
# et servir via URLs signées (ne jamais exposer les pièces en public).
STORAGE_DIR="./storage/kyc"

# --- Routage (OSRM) ---
# Self-host recommandé (voir osrm/README.md). Démo publique en dépannage.
OSRM_URL="http://localhost:5000"

# --- Wave Business API ---
WAVE_API_BASE="https://api.wave.com/v1"
WAVE_API_KEY="secret_xxx"              # clé du compte Wave Business
WAVE_WEBHOOK_SECRET="whsec_xxx"        # secret de signature des webhooks

# --- Orange Money Sénégal — API Web Payment (Orange Developer / Sonatel) ---
OM_TOKEN_URL="https://api.orange.com/oauth/v3/token"
OM_API_BASE="https://api.orange.com/orange-money-webpay"
OM_COUNTRY="sn"                 # 'dev' en sandbox
OM_CURRENCY="XOF"              # 'OUV' en sandbox
OM_MERCHANT_KEY=""             # clé marchand fournie par Sonatel
# Auth OAuth2 : soit l'en-tête complet fourni par Orange...
OM_AUTH_HEADER=""             # ex. "Basic <base64(consumer_key:consumer_secret)>"
# ...soit le couple consumer key/secret (l'en-tête est alors construit automatiquement)
OM_CONSUMER_KEY=""
OM_CONSUMER_SECRET=""
