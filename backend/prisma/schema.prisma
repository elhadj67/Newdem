// Prisma mappe le modèle relationnel. Les colonnes PostGIS (geography) sont
// déclarées en Unsupported : on les lit/écrit via requêtes brutes ($queryRaw),
// notamment le matching géospatial (voir src/matching/matching.service.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

enum UserRole      { passenger driver admin }
enum KycStatus     { pending submitted approved rejected }
enum DriverStatus  { offline online on_trip }
enum VehicleType   { car moto }
enum TripStatus    { requested assigned accepted arriving in_progress completed cancelled no_driver }
enum PaymentMethod { cash wave orange_money }
enum PaymentStatus { pending processing paid failed refunded }
enum TxnType       { ride_payment commission payout wallet_topup refund }
enum TxnDirection  { in out }

model User {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone     String   @unique @db.VarChar(20)
  name      String?  @db.VarChar(120)
  role      UserRole @default(passenger)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  driver    Driver?
  trips     Trip[]   @relation("passenger")
  refreshTokens RefreshToken[]
  @@map("users")
}

model Driver {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String        @unique @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus   KycStatus     @default(pending) @map("kyc_status")
  status      DriverStatus  @default(offline)
  rating      Decimal       @default(5.00) @db.Decimal(3, 2)
  ratingCount Int           @default(0) @map("rating_count")
  // last_location GEOGRAPHY(Point,4326) — géré en SQL brut
  lastLocation Unsupported("geography(Point, 4326)")? @map("last_location")
  lastSeenAt  DateTime?     @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  vehicles    Vehicle[]
  wallet      Wallet?
  trips       Trip[]
  documents   DriverDocument[]
  @@map("drivers")
}

model Vehicle {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId  String      @map("driver_id") @db.Uuid
  driver    Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      VehicleType
  brand     String?     @db.VarChar(60)
  model     String?     @db.VarChar(60)
  color     String?     @db.VarChar(40)
  plate     String      @unique @db.VarChar(20)
  seats     Int         @default(4) @db.SmallInt
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  @@map("vehicles")
}

model DriverDocument {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(40)
  fileUrl   String   @map("file_url")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("driver_documents")
}

model Pricing {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  vehicleType   VehicleType @map("vehicle_type")
  baseFare      BigInt      @map("base_fare")
  perKm         BigInt      @map("per_km")
  perMin        BigInt      @map("per_min")
  minimumFare   BigInt      @map("minimum_fare")
  commissionPct Decimal     @default(0.180) @map("commission_pct") @db.Decimal(4, 3)
  isActive      Boolean     @default(true) @map("is_active")
  effectiveFrom DateTime    @default(now()) @map("effective_from") @db.Timestamptz
  @@map("pricing")
}

model Trip {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  passengerId       String         @map("passenger_id") @db.Uuid
  passenger         User           @relation("passenger", fields: [passengerId], references: [id])
  driverId          String?        @map("driver_id") @db.Uuid
  driver            Driver?        @relation(fields: [driverId], references: [id])
  vehicleType       VehicleType    @map("vehicle_type")
  status            TripStatus     @default(requested)
  origin            Unsupported("geography(Point, 4326)")
  originLabel       String?        @map("origin_label")
  destination       Unsupported("geography(Point, 4326)")
  destinationLabel  String?        @map("destination_label")
  estDistanceKm     Decimal?       @map("est_distance_km") @db.Decimal(6, 2)
  estDurationMin    Decimal?       @map("est_duration_min") @db.Decimal(6, 1)
  actualDistanceKm  Decimal?       @map("actual_distance_km") @db.Decimal(6, 2)
  actualDurationMin Decimal?       @map("actual_duration_min") @db.Decimal(6, 1)
  quotedFare        BigInt         @map("quoted_fare")
  finalFare         BigInt?        @map("final_fare")
  commissionAmount  BigInt?        @map("commission_amount")
  paymentMethod     PaymentMethod? @map("payment_method")
  paymentStatus     PaymentStatus  @default(pending) @map("payment_status")
  requestedAt       DateTime       @default(now()) @map("requested_at") @db.Timestamptz
  assignedAt        DateTime?      @map("assigned_at") @db.Timestamptz
  acceptedAt        DateTime?      @map("accepted_at") @db.Timestamptz
  startedAt         DateTime?      @map("started_at") @db.Timestamptz
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  transactions      Transaction[]
  ledgerEntries     WalletLedger[]
  @@map("trips")
}

model Wallet {
  id         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  driverId   String         @unique @map("driver_id") @db.Uuid
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  balance    BigInt         @default(0)
  minBalance BigInt         @default(-2000) @map("min_balance")
  currency   String         @default("XOF") @db.Char(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  ledger     WalletLedger[]
  @@map("wallets")
}

model WalletLedger {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  walletId     String   @map("wallet_id") @db.Uuid
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tripId       String?  @map("trip_id") @db.Uuid
  trip         Trip?    @relation(fields: [tripId], references: [id])
  type         TxnType
  amount       BigInt
  balanceAfter BigInt   @map("balance_after")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("wallet_ledger")
}

model Transaction {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tripId         String?       @map("trip_id") @db.Uuid
  trip           Trip?         @relation(fields: [tripId], references: [id])
  walletId       String?       @map("wallet_id") @db.Uuid
  provider       String        @db.VarChar(20)
  method         PaymentMethod
  direction      TxnDirection
  amount         BigInt
  status         PaymentStatus @default(pending)
  externalRef    String?       @map("external_ref")
  idempotencyKey String?       @unique @map("idempotency_key")
  raw            Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  @@map("transactions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@map("refresh_tokens")
}

model Rating {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  stars     Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@unique([tripId, raterId])
  @@map("ratings")
}
